{
  "version": 2,
  "rewrites": [
    { "source": "/api/search", "destination": "/api/search.py" },
    { "source": "/api/norma",  "destination": "/api/norma.py"  },
    { "source": "/api/ingest", "destination": "/api/ingest.py" },
    { "source": "/",           "destination": "/public/index.html" },
    { "source": "/(.*)",       "destination": "/public/$1" }
  ]
}
