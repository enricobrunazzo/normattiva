{
  "version": 2,
  "builds": [
    { "src": "api/search.py",  "use": "@vercel/python", "config": { "maxLambdaSize": "15mb" } },
    { "src": "api/norma.py",   "use": "@vercel/python", "config": { "maxLambdaSize": "15mb" } },
    { "src": "api/ingest.py",  "use": "@vercel/python", "config": { "maxLambdaSize": "15mb" } },
    { "src": "public/**",      "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/search", "dest": "/api/search.py" },
    { "src": "/api/norma",  "dest": "/api/norma.py" },
    { "src": "/api/ingest", "dest": "/api/ingest.py" },
    { "src": "/(.*)",       "dest": "/public/$1" }
  ]
}
